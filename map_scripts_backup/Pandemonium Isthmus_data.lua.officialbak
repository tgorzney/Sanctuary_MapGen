    -- Host sets the actual navmap modifiers (simulation-authoritative pathing block) plus the
    -- global placement grid; client sets only its local placement grid (mirrors
    -- common/playableAreaBarrier.lua's CreateBarrier/SetBarrierSize/SetBarrierEnabled exactly --
    -- navmap modifiers are never touched client-side there either).
    -- ⚠️ THE BUG, found 2026-08-28. This Import was MISSING, and its absence is why
    -- navmesh blocking has never worked since it broke.
    --
    -- SpawnAirBlockerNavmapModifiers below calls NavmapModifiers.GetNavmapModifierIDs(...).
    -- `NavmapModifiers` is NOT an engine global -- every real consumer imports it
    -- (common/playableAreaBarrier.lua:1, host/units/unitsClasses/unitsBaseClass.lua:14).
    -- Without this line the bare identifier resolved to _G.NavmapModifiers = nil, so indexing
    -- it threw "attempt to index a nil value" EVERY time, on the host `else` branch -- the one
    -- that does the actual navmesh work. The client branch uses Engine.SetLocalGridModifier*
    -- and never touches NavmapModifiers, which is why only host-side blocking died.
    --
    -- The throw was invisible: it happens inside a NewThread callback, where
    -- common/systems/threads.lua's ResumeThread swallows errors, and Warn() goes to the F1
    -- console, which does not work in this build.
    local NavmapModifiers = Import("common/navmapModifiers.lua")

    local function SpawnAirBlockerNavmapModifiers()
        for _, rect in ipairs(AIR_BLOCKER_RECTS) do
            local size = EngineClasses.float2(rect.sizeX, rect.sizeZ)
            local errorCode, id = Engine.InstantiatePrefab(
                _G.PlayableAreaBarrierPrefabID,
                EngineClasses.float3(rect.x, 0, rect.z),
                EngineClasses.float3(1, 1, 1),
                EngineClasses.quaternion()
            )

            if errorCode ~= EngineErrorCode.Success then
                Warn("SANGEN: air-blocker prefab instantiate failed, errorCode="..tostring(errorCode))
            elseif IsClient then
                Engine.SetLocalGridModifierSize(id, size)
                Engine.SetLocalGridModifierEnabled(id, true)
            else
                local modifierIDs = NavmapModifiers.GetNavmapModifierIDs(id, _G.PlayableAreaBarrierLayers)
                NavmapModifiers.SetNavmapModifiersSize(modifierIDs, size)
                NavmapModifiers.SetNavmapModifiersEnabled(modifierIDs, true)
                Engine.SetGlobalGridModifierSize(id, size)
                Engine.SetGlobalGridModifierEnabled(id, true)
            end
        end
    end

    -- ⚠️ 2026-08-28: the NewThread that used to sit here is GONE -- folded into the single
    -- one near the end of this file. The comment it carried was wrong, and the bug it caused
    -- is the one that hid every scenario unit spawn:
    --
    -- It asserted "IsHost is false here", i.e. that host and client are mutually exclusive.
    -- They are NOT. A solo or listen-server match against AI is host AND client in the same
    -- process, so BOTH NewThread calls in this file fired -- and only ONE NewThread per script
    -- is honored (session_findings_2026-08-17_unit_spawning.md §3, discovered the hard way).
    -- This one ran first, claimed the single slot, and the HOST thread below -- which sets the
    -- playable area AND spawns every scenario unit -- was silently dropped. No error, no log,
    -- nothing on screen. Exactly the "units did not spawn" symptom, and it would only ever
    -- reproduce in a lobby where the tester is also the host, which is every local test.

    -- Reads the lobby directly rather than GameInfo.MapData.armies (static per-map
    -- data, same regardless of lobby size). Returns total/human/AI counts AND a
    -- per-armyID occupancy map ({ [1] = "human", [2] = "human", [3] = "ai" } for a
    -- 2-human-1-AI lobby, armyID 4 simply absent = unoccupied). playerInfo[i].armyID
    -- is the same field common/gameUtils.lua's CreateArmies() correlates against
    -- mapStartSlotIndex (1 = ARMY_01, 2 = ARMY_02, ... alphabetically sorted army
    -- names), and playerType is compared against PlayerType.AI the same way
    -- CreateArmies() decides whether to attach aiSettings -- both confirmed real
    -- fields read directly from common/gameUtils.lua:221-258. This all runs BEFORE
    -- RunMapSetup (see below), so Armies isn't populated yet -- reading the raw lobby
    -- table directly is the only option here.
    -- 2026-08-20, per the user: stop transforming this into our own invented shape
    -- and just keep the OFFICIAL array Engine.GetLobbyInformation() returns
    -- (lobbyInfo.playersInformation, one entry per filled slot with real fields
    -- .armyID and .playerType) as the stored reference. Anything else we need
    -- (counts, the slot-pattern string) gets derived from this same array on
    -- demand rather than living as a separate parallel structure.
    local function ReadLobby()
        local infoOk, lobbyInfo = pcall(Engine.GetLobbyInformation)
        if not infoOk or not lobbyInfo or not lobbyInfo.playersInformation then
            return nil
        end

        local total, humanCount, aiCount = 0, 0, 0
        for _, player in ipairs(lobbyInfo.playersInformation) do
            total = total + 1
            if player.playerType == PlayerType.AI then
                aiCount = aiCount + 1
            else
                humanCount = humanCount + 1
            end
        end
        return total, humanCount, aiCount, lobbyInfo.playersInformation
    end

    local total, humanCount, aiCount, playersInformation = ReadLobby()
    if not total then
        Log("SANGEN: could not read lobby information during LoadMapData -- leaving playable area/resource spots at map defaults.")
        return
    end

    -- 2026-08-20, per the user: a per-slot pattern string ("h"=human, "A"=AI,
    -- "-"=empty), one character per army slot 1-16 (this map's own max, ARMY_01
    -- through ARMY_16 -- the current lobby UI reportedly only exposes 8 of them,
    -- but the map itself supports all 16, so this covers the full range rather than
    -- assuming the UI's current limit is permanent). This exists because aggregate
    -- counts alone are ambiguous: "1 human + 3 AI" is identical whether the human
    -- is in slot 1 or slot 4 under total/humanCount/aiCount, but WHICH slots are
    -- filled matters -- e.g. 4 humans in slots 1-4 (near this map's compact center
    -- cluster) vs. slots 5-8 (this map's original, far-scattered vanilla positions)
    -- plausibly need different areas even though every count is identical. Built
    -- directly from playersInformation (the official array) -- no separate stored map.
    local function BuildSlotPattern(players)
        local chars = {}
        for i = 1, 16 do
            chars[i] = "-"
        end
        for _, player in ipairs(players) do
            if player.armyID and player.armyID >= 1 and player.armyID <= 16 then
                chars[player.armyID] = (player.playerType == PlayerType.AI) and "A" or "h"
            end
        end
        return table.concat(chars)
    end
    local slotPattern = BuildSlotPattern(playersInformation)

    -- Resolves the matching scenario, mutates GameInfo.MapData's spawn/alloy markers
    -- accordingly (must happen before RunMapSetup / CreateArmies read them -- see
    -- Scenarios_Script.lua's ApplyScenario for why), and returns the chosen playable
    -- area + whether this composition spawns extra units (battleships/fighters/etc,
    -- 2026-08-27 rewrite -- was naval-fleet-only, renamed navyEnabled->spawnsUnitsEnabled).
    -- Declared before NewThread because the thread closes over them; assigned after it, by
    -- the pcall'd ResolveAndApply call below.
    local chosenArea, spawnsUnitsEnabled

    -- Only the host resizes the area / toggles resource spots / spawns fleets --
    -- it's authoritative and broadcasts results to clients automatically
    -- (host/managers/playableArea/hostPlayableAreaManager.lua; CreateUnit likewise
    -- broadcasts a create command per unit). RunMapSetup() (which creates every
    -- surviving alloy resource spot) hasn't run yet at this point during
    -- LoadMapData -- NewThread defers this to the end of the same tick, after
    -- RunMapSetup has run (host/hostMain.lua's OnSimulationTickUpdate: RunMapSetup
    -- at line 67, thread dispatch at line 105, both same tick-0 pass). Errors inside
    -- a NewThread callback are already caught safely by the threading system itself
    -- (common/systems/threads.lua's ResumeThread) -- only the synchronous code above
    -- needed the explicit pcall.
    -- The ONE NewThread this file is allowed. Registered unconditionally so it exists in every
    -- role; the host-only and client-only work are guarded INSIDE it rather than by wrapping
    -- separate NewThread calls, which is what broke.
    NewThread(function()
        -- Stage 1: the thread started at all. First statement on purpose -- pcall-wrapped
        -- inside, so it cannot throw and cannot starve anything below it.
        -- Reports how far the SYNCHRONOUS code got, not how far this thread got.
        -- COUNT THE ROW AT MAP CENTRE. Each mark below adds one unit to it.
        --   1 unit  -> thread ran, but Scenario.ResolveAndApply THREW
        -- No area means ResolveAndApply threw; bail rather than raising a second, misleading
        -- error on a nil dereference that would mask the real one.
        if not chosenArea then return end

        -- ⚠️ ORDER IS LOAD-BEARING, 2026-08-28. Errors inside a NewThread callback are
        -- swallowed by common/systems/threads.lua's ResumeThread, and Log()/Warn() go to the
        -- F1 console, which does not work in this build -- so anything that throws here
        -- silently cancels everything after it, with no trace anywhere. Two ordering
        -- constraints, learned from breaking each of them:
        --
        --   1. The playable area must be set BEFORE the air blocker instantiates its prefabs.
        --      SetPlayableArea is called twice (a throwaway 1x1 nudge, then the real area) to
        --      force the resource-spot pass to run. Prefabs created ahead of that risk being
        --      culled by the 1x1 area. This was the original order and it is restored here.
        --   2. The air blocker must come BEFORE any diagnostic. It used to be the entire body
        --      of the client state's own NewThread, so nothing could precede it; once the two
        --      NewThreads in this file were merged it landed last, behind a probe, and a throw
        --      in that probe took it down. New work goes at the BOTTOM of this function.
        if IsHost then
            local Area = Import("common/area.lua").Area
            local PlayableAreaManager = Import("host/managers/playableArea/hostPlayableAreaManager.lua")

            -- SetPlayableArea() only runs the resource-spot enable/disable pass when the area
            -- actually changes from what's already active. Nudge it to a throwaway area first
            -- so the real call below is guaranteed to differ and always runs that pass, even
            -- if chosenArea happens to match the map's baked default.
            PlayableAreaManager.SetPlayableArea(Area.FromMapArea({ x = -1000, y = -1000, width = 1, height = 1 }))
            PlayableAreaManager.SetPlayableArea(Area.FromMapArea(chosenArea))
        end

        -- Runs in BOTH states, once each, and each does the work appropriate to its own role
        -- (the IsClient/else branch inside it) -- the same per-state pattern
        -- common/playableAreaBarrier.lua's CreateBarrier uses. On the host it is now correctly
        -- after the area is final; on the client there is no area call to wait for.
        -- Stage 2: the IsHost block completed without throwing.

        if IsHost and spawnsUnitsEnabled then
            local unitsOk, unitsErr = pcall(Scenario.SpawnMatchedScenarioUnits, chosenArea)
            if not unitsOk then
                Warn("SANGEN: scenario unit spawn failed, rest of map load unaffected: "..tostring(unitsErr))
            end
        end

        -- LAST, and pcall'd. Ordering lesson paid for twice today: this used to sit AHEAD of
        -- the unit spawn, so when it threw (see the missing Import above) it silently killed
        -- every scenario unit as collateral damage. Nothing load-bearing goes after it, and
        -- its errors can no longer cascade into anything else.
        local blockerOk, blockerErr = pcall(SpawnAirBlockerNavmapModifiers)
        if not blockerOk then
            Warn("SANGEN: SpawnAirBlockerNavmapModifiers threw: "..tostring(blockerErr))
        end

    end)

    -- Deliberately AFTER NewThread, and pcall'd separately from the file's outer pcall so a
    -- throw here is attributable to THIS call rather than to the whole chunk.
    local resolveOk, resolvedArea, resolvedSpawnsUnits =
        pcall(Scenario.ResolveAndApply, total, humanCount, aiCount, slotPattern)
    if resolveOk then
        chosenArea, spawnsUnitsEnabled = resolvedArea, resolvedSpawnsUnits
    else
        Warn("SANGEN: Scenario.ResolveAndApply threw: "..tostring(resolvedArea))
    end

end)

if not ok then
    Warn("SANGEN: Pandemonium Isthmus_data.lua failed, map loads with defaults instead: "..tostring(err))
end

-- No MapData override returned: LoadMapData's merge is upsert-only and can't hide
-- markers by omission (mex deletion above mutates GameInfo.MapData directly instead,
-- before RunMapSetup reads it).
return {}
