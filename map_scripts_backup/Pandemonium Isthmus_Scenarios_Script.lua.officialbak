-- The two symmetric deep-water ponds, found 2026-08-27 by directly analyzing
-- Textures/heightmap.raw (connected-component flood fill of cells below
-- waterLevel=78): the two largest components are near-identical size (1,262,948 /
-- 1,262,197 map-units^2, next largest under 800) and confirmed 180-degree-rotational
-- mirrors of each other about the map center (1024,1024) -- rotating either pond's
-- deepest point lands inside the other pond within ~16 units. These are almost
-- certainly the two ponds this file's earlier naval code always called "flanking
-- both sides."
local BATTLESHIP_SPAWN_Y = 78.0  -- waterLevel -- ships float at the surface, not the
                                  -- seabed (matches the removed naval code's own
                                  -- NavalFindSpot, which always returned waterLevel)

-- ============================================================================
-- 2026-08-28, per the human: hardcoded pond coordinates are GONE. Every fleet
-- position is now derived live from that army's own Spawn marker, exactly the way
-- the naval spawner that actually SHIPPED in this map did it
-- (`Pandemonium Isthmus_data.lua.backup-2026-08-20-presplit`, SpawnNavalFleets:
-- read GameInfo.MapData.markers.Spawn.transforms[army.name], offset sideways to
-- reach the flanking water, spiral-search from there). That file is the real
-- reference for this map -- NOT `SpawnArmies.lua.bak`, which is an unrun backup
-- whose "confirmed working" status comes only from its own comments.
--
-- Why the old approach failed: BATTLESHIP_POSITIONS was 8 literal points derived
-- OFFLINE from Textures/heightmap.raw, then "corrected" at runtime by a spiral probe
-- that returned `idealX, idealZ` when it found nothing -- i.e. a DRY point. CreateUnit
-- then returned falsy, the miss was counted into a Log() line, and Log() goes to the
-- F1 console, which does not work in this build. Total failure and total success
-- looked identical. Nothing hardcoded, and nothing that fails silently, survives here.
-- ============================================================================

-- How far sideways from an army's Spawn marker to begin looking for its water body.
-- The shipped SpawnNavalFleets used 90 with an explicit per-army west/east bias; this
-- map's playable strip has water flanking BOTH sides, so both directions are probed and
-- whichever yields deeper water wins -- no hand-authored side table to keep in sync.
local WATER_SEARCH_SIDE_OFFSET = 90

-- Deepest-water search. Unlike a first-hit spiral, this scans its WHOLE budget and keeps
-- the deepest cell found, so a fleet anchors in open water rather than in the first
-- puddle encountered on the way out -- "deepest water closest to spawn", per the human.
-- Ties broken by distance to the search origin (earlier spiral index = closer).
local DEEP_WATER_SCAN_STEP = 3.0
local DEEP_WATER_SCAN_TRIES = 900
local DEEP_WATER_MINIMUM_DEPTH = 4.0   -- world units below waterLevel; shallower cells are
                                        -- rejected outright so a fleet never anchors on a
                                        -- beach shelf a hull cannot actually float on

local SLOT_ANGLE_DEGREES = { [5] = 0, [6] = 90, [7] = 180, [8] = 270 }
local FIGHTER_SPREAD_RADIUS = 700      -- world units from map center for the fighter
                                        -- squadron's anchor -- large enough to keep 4
                                        -- players' 150-unit blocks apart
local FIGHTER_ALTITUDE_ABOVE_GROUND = 60  -- height ABOVE sampled terrain, not an absolute
                                           -- world Y -- terrain near map center sits around
                                           -- Y 78-83 (heightmap calibration, 2026-08-27), so
                                           -- a bare absolute 60 would spawn fighters
                                           -- underground almost everywhere on this map

local function DegreesToRadians(d) return d * math.pi / 180.0 end

-- Spiral coordinate generator, same algorithm as `Pandemonium Isthmus_SpawnArmies.lua.bak`'s
-- GetSpiralGridXZ (itself copied there from host/testUtils.lua's SpawnUnits) -- copied here
-- rather than Import()'d, matching this file's existing no-extra-Import convention.
local WATER_SPIRAL_STEP = 3.0
local WATER_SPIRAL_MAX_TRIES = 200
local function GetSpiralGridXZ(n)
    local k = math.ceil((math.sqrt(n) - 1) / 2)
    local t = 2 * k + 1
    local m = t ^ 2
    t = t - 1
    if n >= m - t then return k - (m - n), -k else m = m - t end
    if n >= m - t then return -k, -k + (m - n) else m = m - t end
    if n >= m - t then return -k + (m - n), k else return k, k - (m - n - t) end
end

-- Nudges (idealX, idealZ) to the nearest spot that's genuinely underwater right now, sampled
-- live against the running engine's own terrain (Engine.SampleTerrainHeightFromCell) --
-- exactly the technique SpawnArmies.lua.bak's CheckSpot/FindValidSpot uses, scoped down to
-- just the water check (no prop/occupied-grid dedup -- ships are sparse enough at this scale
-- not to need it). This is what makes battleship placement robust against any residual error
-- in the offline heightmap analysis BATTLESHIP_POSITIONS came from: it's corrected live, not
-- just trusted. Falls back to the original point if nothing valid turns up in budget --
-- SpawnUnits' own CreateUnit-return-value check is the final safety net either way.
local function FindNearbyWaterSpot(idealX, idealZ, waterLevel)
    for n = 1, WATER_SPIRAL_MAX_TRIES do
        local gx, gz = GetSpiralGridXZ(n)
        local x = idealX + gx * WATER_SPIRAL_STEP
        local z = idealZ + gz * WATER_SPIRAL_STEP
        local errorCode, h = Engine.SampleTerrainHeightFromCell(EngineClasses.int2(math.floor(x), math.floor(z)))
        if errorCode == EngineErrorCode.Success and h < waterLevel then
            return x, z
        end
    end
    -- ⚠️ 2026-08-28: returns nil, NOT `idealX, idealZ`. The old fallback handed the caller a
    -- point it had just PROVEN was not water; CreateUnit then failed silently and the ship
    -- vanished with no visible trace. The shipped SpawnNavalFleets got this right --
    -- its NavalFindSpot ends in a bare `return nil` and the caller counts the miss.
    -- Never substitute a known-bad position for a failure.
    return nil
end

-- Finds the DEEPEST water within budget of (originX, originZ), not merely the first water.
-- Returns x, z, depth -- or nil when the whole budget yields nothing at or past
-- DEEP_WATER_MINIMUM_DEPTH. Cost is one Engine.SampleTerrainHeightFromCell per probe,
-- DEEP_WATER_SCAN_TRIES times per army, once per match at load -- not a per-tick path.
local function FindDeepestWaterNear(originX, originZ, waterLevel)
    local bestX, bestZ, bestDepth = nil, nil, DEEP_WATER_MINIMUM_DEPTH
    for n = 1, DEEP_WATER_SCAN_TRIES do
        local gx, gz = GetSpiralGridXZ(n)
        local x = originX + gx * DEEP_WATER_SCAN_STEP
        local z = originZ + gz * DEEP_WATER_SCAN_STEP
        local errorCode, h = Engine.SampleTerrainHeightFromCell(EngineClasses.int2(math.floor(x), math.floor(z)))
        if errorCode == EngineErrorCode.Success then
            local depth = waterLevel - h
            -- Strict `>` keeps the FIRST cell at a given depth, and the spiral visits
            -- nearer cells first, so ties resolve toward the spawn marker automatically.
            if depth > bestDepth then
                bestX, bestZ, bestDepth = x, z, depth
            end
        end
    end
    if not bestX then return nil end
    return bestX, bestZ, bestDepth
end

-- Resolves one army's fleet anchor: probe BOTH flanks of its Spawn marker and take the
-- deeper result. Returns nil (and the caller counts every ship as missed) when neither
-- flank has water -- there is no "just put them somewhere" branch by design.
local function FindFleetAnchorForArmy(armyName, waterLevel, fallbackX, fallbackZ)
    local spawnMarker = GameInfo.MapData.markers
        and GameInfo.MapData.markers.Spawn
        and GameInfo.MapData.markers.Spawn.transforms
        and GameInfo.MapData.markers.Spawn.transforms[armyName]

    -- Reading markers.Spawn.transforms[army.name] directly (rather than GetMarker/
    -- MarkerToPosition) is the pattern confirmed live 2026-08-17 -- see
    -- session_findings_2026-08-17_unit_spawning.md §5, which chose it specifically to
    -- avoid an unverified global-reachability dependency.
    local originX = (spawnMarker and spawnMarker.position.x) or fallbackX
    local originZ = (spawnMarker and spawnMarker.position.z) or fallbackZ

    local bestX, bestZ, bestDepth = nil, nil, 0
    for _, side in ipairs({ -1, 1 }) do
        local x, z, depth = FindDeepestWaterNear(
            originX + side * WATER_SEARCH_SIDE_OFFSET, originZ, waterLevel)
        if x and depth > bestDepth then
            bestX, bestZ, bestDepth = x, z, depth
        end
    end
    return bestX, bestZ, bestDepth
end

-- Appends a compact grid of `count` units (roughly square, `spacing` apart) centered
-- on (centerX, centerZ) at height y, owned by armyIndex, into outInstructions. When
-- `requiresWater` is true, EVERY grid point is individually nudged via FindNearbyWaterSpot
-- before being appended -- not just the formation's own anchor.
local function AppendUnitGrid(outInstructions, armyIndex, templateIdentifier, centerX, y, centerZ, count, spacing, requiresWater)
    local columns = math.ceil(math.sqrt(count))
    local rows = math.ceil(count / columns)
    local startX = centerX - (columns - 1) * spacing * 0.5
    local startZ = centerZ - (rows - 1) * spacing * 0.5
    local placed = 0
    for row = 0, rows - 1 do
        for col = 0, columns - 1 do
            if placed >= count then break end
            local x = startX + col * spacing
            local z = startZ + row * spacing
            local bAppend = true
            if requiresWater then
                -- FindNearbyWaterSpot now returns nil on failure. A grid point that cannot be
                -- resolved to real water is DROPPED and counted, never appended at its dry
                -- coordinate -- the caller turns the shortfall into visible deficit markers.
                local wx, wz = FindNearbyWaterSpot(x, z, y)  -- y is waterLevel here
                if wx then x, z = wx, wz else bAppend = false end
            end
            if bAppend then
                outInstructions[#outInstructions + 1] = {
                    armyIndex = armyIndex,
                    templateIdentifier = templateIdentifier,
                    x = x,
                    y = y,
                    z = z,
                }
            end
            placed = placed + 1
        end
    end
end

-- Builds the flat UnitSpawnInstruction array for every occupied army in slots 5-8:
-- 10 battleships in EACH pond plus a 150-fighter squadron, all offset by a fixed
-- per-slot angle. Reads the real, populated `Armies` table (not slotPattern position
-- math) for armyIndex/army.name, matching this file's existing occupancy-check idiom
-- in ApplyScenario/the old SpawnNavalFleets.
local function BuildSlots5to8Instructions(area)
    local instructions = {}
    local _, waterLevel = Engine.GetWaterLevel()
    for armyIndex, army in pairs(Armies) do
        -- ⚠️ FIXED 2026-08-28: this was `if not army.lobbyOptions.isEmptySlot then` -- an
        -- UNGUARDED dereference. `lobbyOptions` is nil on at least some army entries (an AI
        -- army is the confirmed case), so that line THREW, and because _data.lua wraps this
        -- whole call in pcall (and Warn() goes to the F1 console, which is unreliable in this
        -- build) the throw was swallowed and NOTHING spawned, with no visible error anywhere.
        --
        -- Confirmed live by the human: a 1v1 with a HUMAN in slot 5 and an AI in slot 6 got the
        -- correct AREA_FULL playable area (set before this call, and never touches lobbyOptions)
        -- and correct alloy handling (ApplyScenario's occupancy branch keys off slotPattern, not
        -- lobbyOptions) -- but zero units. This line was the only lobbyOptions reader in the file.
        --
        -- Latent, not new: the removed SpawnNavalFleets used the identical unguarded check, but
        -- navy/spawnsUnits was only ever true on the all-human "4human" scenario, so no AI army
        -- ever reached it until slots5to8AnyFilled shipped.
        --
        -- nil lobbyOptions => treat as OCCUPIED (correct: an AI slot is filled). Never assume a
        -- missing options table means an empty slot -- that would silently skip real players.
        local bIsEmptySlot = army.lobbyOptions and army.lobbyOptions.isEmptySlot
        if not bIsEmptySlot then
            local slotNumber = tonumber(army.name:match("^ARMY_0?(%d+)$"))
            if slotNumber and SLOT_ANGLE_DEGREES[slotNumber] then
                local angle = DegreesToRadians(SLOT_ANGLE_DEGREES[slotNumber])
                -- Anchor resolved LIVE from this army's Spawn marker (both flanks probed,
                -- deeper wins). No hardcoded pond table any more.
                local anchorX, anchorZ = FindFleetAnchorForArmy(
                    army.name, waterLevel, area and (area.x + area.width * 0.5) or 1024,
                    area and (area.y + area.height * 0.5) or 1024)

                -- Grid spacing 8 (not the original 12): verified via
                -- scratchpad/verify_full_grids.py against the real depth mask that spacing 12
                -- put 8/80 ships on dry land (multiple points per formation, not just the
                -- anchor); spacing 8 reduces that to 1/80 (slot 8's pondB formation, one
                -- corner cell). Each unit is already spawned via its own pcall (SpawnUnits),
                -- so one ship failing to create is a minor, self-contained miss, not a
                -- formation-wide failure -- accepted rather than hand-authoring all 80 exact
                -- points, which the rectangular-grid approach exists to avoid.
                if anchorX then
                    -- Both of this army's former "ponds" collapse into one fleet at the single
                    -- deepest anchor found near its own spawn. Splitting a fleet across two
                    -- hand-picked ponds was an artifact of the hardcoded table, not a
                    -- requirement. y is waterLevel: hulls float at the surface.
                    AppendUnitGrid(instructions, armyIndex, BATTLESHIP_TPID,
                        anchorX, waterLevel, anchorZ,
                        BATTLESHIPS_PER_PLAYER_PER_POND * 2, 8, true)
                end

                local fighterOffsetX = math.cos(angle) * FIGHTER_SPREAD_RADIUS
                local fighterOffsetZ = math.sin(angle) * FIGHTER_SPREAD_RADIUS
                local fighterX, fighterZ = 1024 + fighterOffsetX, 1024 + fighterOffsetZ
                -- Sample REAL terrain height at the squadron's anchor point, same Engine API
                -- the removed naval code used for its own position validation
                -- (Engine.SampleTerrainHeightFromCell) -- one sample per squadron, not per
                -- unit, since a 150-unit block is compact enough that one ground reading is a
                -- reasonable approximation. Falls back to waterLevel-ish 78 (not FIGHTER_
                -- ALTITUDE_ABOVE_GROUND alone) only if the sample itself fails, so a failed
                -- sample still lands near the map's typical terrain height, not underground.
                local sampleOk, groundHeight = Engine.SampleTerrainHeightFromCell(
                    EngineClasses.int2(math.floor(fighterX), math.floor(fighterZ)))
                local fighterY = (sampleOk == EngineErrorCode.Success and groundHeight or 78)
                    + FIGHTER_ALTITUDE_ABOVE_GROUND
                AppendUnitGrid(instructions, armyIndex, FIGHTER_TPID,
                    fighterX, fighterY, fighterZ,
                    FIGHTERS_PER_PLAYER, 6)
            end
        end
    end
    return instructions
end

-- Dispatch: which scenario needs which generator. Only "slots5to8AnyFilled" builds
-- anything today -- extend this if/elseif as more scenarios get their own unit spawns
-- (a per-scenario builder-function table once there are more than ~2-3 of these, not
-- before -- no abstraction for a single case). Must run after RunMapSetup (see
-- _data.lua's NewThread comment for the ordering proof) so Armies is populated.
function Scenario.SpawnMatchedScenarioUnits(area)
    if currentMatchedScenarioName == "slots5to8AnyFilled" then
        Scenario.SpawnUnits(BuildSlots5to8Instructions(area))
    end
end

return Scenario
