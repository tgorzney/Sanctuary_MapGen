-- SANGEN scenario code -- Pandemonium Isthmus. Lobby-composition scenario
-- definitions (playable area, spawn positions, per-army mex/alloy visibility) and
-- naval fleet spawning. Held here, not in Pandemonium Isthmus_data.lua, per the
-- ratified scenario-script file split (sangen_arch_pack/specs/MODDING_SCRIPTING_SPEC.md,
-- "Scenario-script file split"): _data.lua is an orchestrator only (reads the lobby,
-- builds the slot pattern, wires the result into the map), this file holds every
-- scenario definition and all the spawning logic behind it.
--
-- SCRIPT-TREE file. Lives at LJ/lua/maps/Pandemonium Isthmus/, BESIDE _data.lua --
-- NOT in the map's asset folder (Sanctuary_Data/Maps/<MapName>/, where the
-- .sanmap/Props/Textures live).
--
-- Why colocated, 2026-08-20: putting this file in the map asset folder was tried and
-- PROVEN IMPOSSIBLE. Import() cannot address anything outside the LJ/lua root -- a
-- "../../Sanctuary_Data/..." path fails Engine.FileExists() outright (verified live
-- in-game: the exact libPath.."/"..path string import.lua builds internally resolves
-- false), so Import() raises its "File doesn't exist" error and aborts the entire
-- calling chunk. This settles Sanctuary_Map_System_Rework.md Sec12 open question 6 in
-- the NEGATIVE. The pair must stay in the same tree; if _data.lua ever relocates to
-- the map folder, this file moves with it.
--
-- Loaded via Import("maps/Pandemonium Isthmus/Pandemonium Isthmus_Scenarios_Script.lua")
-- -- a libPath-root-relative path, the same convention every other Import() call site
-- uses (Import("common/gameUtils.lua"), etc.).

-- NOT local: Import() (common/systems/import.lua) does not use this file's `return`
-- statement at all -- it only captures GLOBAL variables a file writes into its own
-- environment table. `Scenario` must be global for `Import(path).Scenario` to work
-- from _data.lua. Confirmed from Import()'s own doc comment, 2026-08-20.
Scenario = {}

-- ============================================================================
-- ROLE PROBE, 2026-08-28. TEMPORARY -- delete once the doubling question is settled.
--
-- Answers exactly one question: how many times, and in which Lua state, does this map
-- script actually execute? script.lua's init() sets IsHost XOR IsClient -- never both in
-- one state -- but InitLobby calls LoadMapData twice (script.lua:156 under `if IsHost`,
-- :189 in the `else`), so a solo match runs TWO states, each loading _data.lua once.
-- Whether both reach unit creation is the open question.
--
-- One BigBot, x stamped by role, all at z = 1024 near map center:
--   x = 1000   spawned from the HOST state
--   x = 1040   spawned from the CLIENT state
--   x = 1080   neither flag set (should be impossible; proves an assumption wrong)
--
-- How to read the result:
--   one bot at 1000 only ......... single execution. No doubling. My inference was wrong.
--   one at 1000 AND one at 1040 .. both states create units. Doubling confirmed + located.
--   TWO bots at 1000 ............. the host state itself runs twice. Different problem.
--
-- ⚠️ Caveat, stated up front: if the client state cannot create units at all, an empty
-- x = 1040 is NOT proof the client state never ran -- only that it created nothing. That
-- case is indistinguishable here and would need a different instrument.
--
-- Army index is brute-forced, never assumed: a previous probe hardcoded army 1 and
-- silently failed in every slots-5-to-8 lobby, which is the exact scenario under test.
-- ============================================================================

-- Candidate areas. Rectangles are in world x/z, matching the .sanmap's "areas"
-- format: {x, y = world z, width, height}.
local AREA_356 = { x = 846, y = 846, width = 356, height = 356 }               -- the map's own baked default
local AREA_169 = { x = 668.4444444444445, y = 824, width = 711.1111111111111, height = 400 } -- 400 height, 16:9
local AREA_1024 = { x = 537, y = 472, width = 974, height = 1104 }             -- 6-player, centered on map center, height +200-50-70 / width -200+150 per the user 2026-08-20
local AREA_FULL = { x = 0, y = 0, width = 2048, height = 2048 }

-- Identity rotation/scale, reused for any alloy marker this file creates fresh
-- (matches every marker already in the .sanmap -- none of them use anything else).
local IDENTITY_ROTATION = { w = 1.0, x = 0.0, y = 0.0, z = 0.0 }
local IDENTITY_SCALE = { x = 1.0, y = 1.0, z = 1.0 }

-- Every alloy marker name any scenario below ever uses, grouped by army. In
-- "explicit" alloyMode, any army in this list that the matched scenario does
-- NOT mention gets its markers deleted (the scenario is authoritative -- if it
-- doesn't list an army's mex, that army isn't part of this layout). In
-- "occupancy" alloyMode, this is instead the deletion list for whichever of
-- these armies has no player in it per slotPattern (the .sanmap's own baked
-- positions are trusted for the rest).
local KNOWN_ALLOY_MARKERS = {
    ARMY_01 = { "AlloyMarker_219", "AlloyMarker_237", "AlloyMarker_97" },
    ARMY_02 = { "AlloyMarker_220", "AlloyMarker_240", "AlloyMarker_99" },
    ARMY_03 = { "AlloyMarker_282", "AlloyMarker_283", "AlloyMarker_284" },
    ARMY_04 = { "AlloyMarker_285", "AlloyMarker_286", "AlloyMarker_287" },
}
local ARMY_ID_TO_NAME = { [1] = "ARMY_01", [2] = "ARMY_02", [3] = "ARMY_03", [4] = "ARMY_04" }

-- ============================================================================
-- SCENARIOS -- 2026-08-20, per the user: a tiered matching system, checked most
-- specific first:
--   TIER 1 (PATTERN_SCENARIOS) -- exact slotPattern string match. For when WHICH
--     slots are filled matters, not just how many (e.g. 4 humans in slots 1-4
--     vs. slots 5-8 -- identical counts, very different actual spawn geography
--     on this map). Empty for now -- nothing has needed this yet -- but the
--     matching path is real and ready.
--   TIER 2 (COUNT_SCENARIOS) -- aggregate total/human/AI count predicates,
--     checked in order, first match wins. This is every composition rule that
--     used to live in a separate "legacy" if/elseif block outside the scenario
--     system entirely -- that duplication is gone now; every composition goes
--     through the exact same ApplyScenario() path.
--   TIER 3 (DEFAULT_SCENARIO) -- always matches, used only if nothing above did.
--
-- Each scenario carries an explicit alloyMode:
--   "explicit" -- the scenario fully lists every army's spawn+alloys; anything
--     in KNOWN_ALLOY_MARKERS it doesn't mention gets deleted. Fully self-
--     contained and immune to any other scenario's data (the fix for a real
--     regression: ARMY_01's position used to be a single static value in the
--     .sanmap shared by every composition -- SpawnInitialUnits,
--     common/gameUtils.lua:356-371, reads
--     GameInfo.MapData.markers.Spawn.transforms[army.name] with no per-
--     composition branching of its own -- so editing it to test the 6-player
--     case silently broke 1v1, which read that exact same value. Confirmed
--     again days later: the same collision hit the 4-human and 1-human-3-AI
--     compositions too, since neither had been migrated into its own entry
--     yet while the 6-player work kept moving the shared baseline).
--   "occupancy" -- no explicit spawns; trust the .sanmap's own baked positions
--     for KNOWN_ALLOY_MARKERS armies that have a player, delete the rest.
--   "keepAll" -- no deletion at all (the 2-human-1-AI case: the one empty
--     slot's mex stay too, extra resources for the lone AI).
--   "delta" -- NOT YET USED by any scenario below; wired in now (2026-08-20,
--     per the user, "so we don't lose the thought") for once a real baseline
--     exists to diff against. Unlike "explicit", silence is NOT a delete
--     instruction -- only scenario.alloys.add / .remove are touched, everything
--     else stays whatever the baseline (or an earlier-applied layer) already
--     set it to. Shape: scenario.alloys = { add = { ARMY_XX = { {name=...,
--     x=..., y=..., z=...}, ... } }, remove = { ARMY_XX = { "MarkerName", ... } } }.
--     A future scenario converts from "explicit" to "delta" by trimming its
--     alloys table down to only what differs from the baseline, once that
--     baseline/diff pass happens.
-- ============================================================================

local PATTERN_SCENARIOS = {
