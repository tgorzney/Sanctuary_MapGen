local DEFAULT_SCENARIO = { name = "default", area = AREA_356, alloyMode = "occupancy" }
local function FindMatchingScenario(total, humanCount, aiCount, slotPattern)
    for _, scenario in ipairs(PATTERN_SCENARIOS) do
        if scenario.pattern == slotPattern then
            return scenario
        end
    end
    for _, scenario in ipairs(COUNT_SCENARIOS) do
        local matchOk, matched = pcall(scenario.match, total, humanCount, aiCount, slotPattern)
        if matchOk and matched then
            return scenario
        end
    end
    return DEFAULT_SCENARIO
end

-- Writes every army's position/alloys from a matched scenario (alloyMode ==
-- "explicit"), or falls back to occupancy-based deletion only ("occupancy"), or
-- leaves every known marker untouched ("keepAll"). Must run before RunMapSetup
-- (common/mapUtils.lua:112-146), which reads GameInfo.MapData.markers.Alloys
-- .transforms directly and unconditionally creates a real resource-spot object
-- for every surviving entry -- and before CreateArmies() (common/gameUtils.lua:
-- 209), whose SpawnInitialUnits step reads GameInfo.MapData.markers.Spawn
-- .transforms directly. This whole function runs synchronously, before either,
-- so mutating those tables here is guaranteed to be what both later steps see.
local function ApplyScenario(scenario, total, slotPattern)
    if scenario.spawns then
        local spawnTransforms = GameInfo.MapData.markers and GameInfo.MapData.markers.Spawn
            and GameInfo.MapData.markers.Spawn.transforms
        if spawnTransforms then
            for armyName, pos in pairs(scenario.spawns) do
                if spawnTransforms[armyName] then
                    spawnTransforms[armyName].position.x = pos.x
                    spawnTransforms[armyName].position.y = pos.y
                    spawnTransforms[armyName].position.z = pos.z
                end
            end
        end
    end

    local alloyTransforms = GameInfo.MapData.markers and GameInfo.MapData.markers.Alloys
        and GameInfo.MapData.markers.Alloys.transforms
    if alloyTransforms then
        if scenario.alloyMode == "explicit" then
            local mentionedArmies = {}
            for armyName, points in pairs(scenario.alloys or {}) do
                mentionedArmies[armyName] = true
                for _, p in ipairs(points) do
                    if not alloyTransforms[p.name] then
                        alloyTransforms[p.name] = { rotation = IDENTITY_ROTATION, scale = IDENTITY_SCALE, position = {} }
                    end
                    alloyTransforms[p.name].position.x = p.x
                    alloyTransforms[p.name].position.y = p.y
                    alloyTransforms[p.name].position.z = p.z
                end
            end
            for armyName, markerNames in pairs(KNOWN_ALLOY_MARKERS) do
                if not mentionedArmies[armyName] then
                    for _, markerName in ipairs(markerNames) do
                        alloyTransforms[markerName] = nil
                    end
                end
            end
        elseif scenario.alloyMode == "occupancy" then
            for armyId = 1, 4 do
                if slotPattern:sub(armyId, armyId) == "-" then
                    local armyName = ARMY_ID_TO_NAME[armyId]
                    for _, markerName in ipairs(KNOWN_ALLOY_MARKERS[armyName]) do
                        alloyTransforms[markerName] = nil
                    end
                    Log("SANGEN: "..armyName.." has no player -- its 3 mex removed before RunMapSetup.")
                end
            end
        elseif scenario.alloyMode == "delta" then
            -- Everything NOT mentioned below is left exactly as the baseline (or
            -- whatever an earlier-applied layer already set it to) -- unlike
            -- "explicit", silence here is NOT a delete instruction. Only used once
            -- a real baseline exists to diff against; see scenario.alloys.add /
            -- .remove shape below.
            for _, points in pairs((scenario.alloys and scenario.alloys.add) or {}) do
                for _, p in ipairs(points) do
                    if not alloyTransforms[p.name] then
                        alloyTransforms[p.name] = { rotation = IDENTITY_ROTATION, scale = IDENTITY_SCALE, position = {} }
                    end
                    alloyTransforms[p.name].position.x = p.x
                    alloyTransforms[p.name].position.y = p.y
                    alloyTransforms[p.name].position.z = p.z
                end
            end
            for _, markerNames in pairs((scenario.alloys and scenario.alloys.remove) or {}) do
                for _, markerName in ipairs(markerNames) do
                    alloyTransforms[markerName] = nil
                end
            end
        end
        -- "keepAll": no deletion, every known marker stays as the .sanmap has it.
    end

    Log("SANGEN: scenario '"..scenario.name.."' applied ("..total.." occupied slot(s)).")
end

-- Set inside ResolveAndApply, read by Scenario.SpawnMatchedScenarioUnits (defined further
-- below) -- declared here, ahead of both, so they close over the same upvalue.
local currentMatchedScenarioName = nil

-- Finds the matching scenario for this lobby composition, applies it (mutating
-- GameInfo.MapData's spawn/alloy markers before RunMapSetup/CreateArmies read them),
-- logs the outcome, and returns the resolved playable area + whether this
-- composition spawns extra units (battleships/fighters/etc, per-scenario -- see
-- Scenario.SpawnMatchedScenarioUnits). Called once, synchronously, from _data.lua's
-- LoadMapData-time pcall.
function Scenario.ResolveAndApply(total, humanCount, aiCount, slotPattern)
    local matchedScenario = FindMatchingScenario(total, humanCount, aiCount, slotPattern)
    local chosenArea, spawnsUnitsEnabled = matchedScenario.area, matchedScenario.spawnsUnits
    -- Bridges into Scenario.SpawnMatchedScenarioUnits, called separately (deferred, post-
    -- RunMapSetup) by _data.lua's NewThread -- that call site only gets `area` back from here,
    -- so this module-local is how it learns WHICH scenario matched. Same bridging pattern the
    -- removed naval code didn't need (it had exactly one navy=true scenario); real now that
    -- SpawnMatchedScenarioUnits dispatches on scenario name.
    currentMatchedScenarioName = matchedScenario.name
    ApplyScenario(matchedScenario, total, slotPattern)

    Log(string.format(
        "SANGEN: %d occupied slot(s) (%d human, %d AI, pattern=%s) -> scenario=%s spawnsUnits=%s, playable area x=%d y=%d w=%d h=%d",
        total, humanCount, aiCount, slotPattern, matchedScenario.name,
        tostring(spawnsUnitsEnabled), chosenArea.x, chosenArea.y, chosenArea.width, chosenArea.height))

    return chosenArea, spawnsUnitsEnabled
end

-- ============================================================================
-- Generic unit spawning, 2026-08-27 rewrite per the user: replaces the naval-only
-- SpawnNavalFleets/NAVAL_FLEET/spiral-search machinery entirely. Deliberately split
-- into two pieces that don't know about each other's concerns:
--   EXECUTOR (Scenario.SpawnUnits)  -- input: a flat, already-resolved array of
--     {armyIndex, templateIdentifier, x, y, z}. Output: those units exist. Knows
--     NOTHING about water, terrain, navmesh, or unit type -- pure input -> output.
--   GENERATOR (BuildSlots5to8Instructions) -- decides WHERE things spawn for one
--     specific scenario. This is scenario-specific, hand-authored placement, not a
--     general procedural placement system -- that's explicitly a separate, not-yet-
--     designed concern (SanGen will own procedural placement; this is a one-off
--     prototype generator for this one scenario, done directly in Lua for now).
-- ============================================================================

-- Batches CreateUnit calls so a big spawn (150 fighters/army) doesn't hitch a tick.
local UNIT_SPAWN_BATCH_SIZE = 100

-- Executor. Never call CreateUnit directly outside this function -- every unit-spawn
-- path (this scenario or a future one) should produce instructions and hand them here.
--
-- ⚠️ CORRECTED 2026-08-28, per the confirmed-working reference `Pandemonium Isthmus_
-- SpawnArmies.lua.bak` (spawns both ucn1001 Frigates and ucn3001 Battleships into this
-- same map's ponds -- the "T1 frigates + T3 battleships in left/right ponds" the human
-- specifically recalled working): position is `EngineClasses.float3(x, y, z)`, matching
-- that file's own `CreateUnit(ARMY, e.tpId, pos)` call exactly.
--
-- Also per that same file's own explicit fix note: "CreateUnit's actual return value is
-- now checked (not just whether pcall raised an error), so silent failures are counted
-- instead of assumed to have worked." `pcall` only catches a THROWN error -- CreateUnit
-- can return normally with a falsy result (e.g. an invalid/occupied/unreachable spot) and
-- pcall alone reports that as success. Both `ok` (didn't throw) AND `unit` (actually got a
-- real object back) are required below.
function Scenario.SpawnUnits(instructions)
    local sinceYield = 0
    local placed, failed = 0, 0
    for _, instr in ipairs(instructions) do
        local ok, unit = pcall(CreateUnit, instr.armyIndex, instr.templateIdentifier,
            EngineClasses.float3(instr.x, instr.y, instr.z))
        if ok and unit then placed = placed + 1 else failed = failed + 1 end

        sinceYield = sinceYield + 1
        if sinceYield >= UNIT_SPAWN_BATCH_SIZE then
            sinceYield = 0
            WaitTicks(1)
        end
    end
    Log(string.format("SANGEN: SpawnUnits placed %d, failed %d (of %d requested).",
        placed, failed, #instructions))
end

