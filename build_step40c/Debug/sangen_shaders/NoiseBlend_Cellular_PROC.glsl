float cellularNoise(int seed, float pointX, float pointY, float jitterModifier) {
    int roundedX = fastRoundToInt(pointX);
    int roundedY = fastRoundToInt(pointY);
    float nearestDistance = 1e10;
    float jitter = cellularJitterScale * jitterModifier;

    uint primedX = primedCoordinateX(roundedX - 1);
    uint primedYBase = primedCoordinateY(roundedY - 1);
    for (int neighbourX = roundedX - 1; neighbourX <= roundedX + 1; ++neighbourX) {
        uint primedY = primedYBase;
        for (int neighbourY = roundedY - 1; neighbourY <= roundedY + 1; ++neighbourY) {
            uint hash = noiseHash(seed, primedX, primedY);
            vec2 offset = cellularJitterVectors[int((hash & uint(255 << 1)) >> 1)];
            float toCellX = (float(neighbourX) - pointX) + offset.x * jitter;
            float toCellY = (float(neighbourY) - pointY) + offset.y * jitter;
            float squaredDistance = toCellX * toCellX + toCellY * toCellY;
            nearestDistance = min(nearestDistance, squaredDistance);
            primedY += primeStepY();
        }
        primedX += primeStepX();
    }
    return nearestDistance - 1.0;
}
